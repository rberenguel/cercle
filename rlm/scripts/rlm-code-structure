#!/usr/bin/env bash
# rlm-code-structure "<symbol>" [limit]
# Structural search: find functions, methods, classes, and types by name (substring match).
# Scoped to CERCLE_SOURCE (defaults to $PWD). Unset to search across all sources.
#
# Indexed symbol types by language:
#   Go:         function, method, type  (e.g. IndexDir, ServeHTTP, LexicalResult)
#   Python:     function, class
#   JavaScript: function, method, class (including arrow functions assigned to variables)
#   Other languages: not indexed — use rlm-search-lexical instead
#
# The search is case-insensitive for ASCII and matches anywhere in the name,
# so "search" matches "LexicalSearch", "searchFiles", and "fullTextSearch".
set -euo pipefail

CERCLE_ADDR="${CERCLE_ADDR:-127.0.0.1:7770}"
CERCLE_SOURCE="${CERCLE_SOURCE:-$PWD}"
SYMBOL="${1:?usage: rlm-code-structure \"<symbol>\" [limit]}"
LIMIT="${2:-20}"

Q_ENC=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$SYMBOL")
SRC_ENC=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$CERCLE_SOURCE")

curl -s --fail-with-body "http://${CERCLE_ADDR}/search/structural?q=${Q_ENC}&source=${SRC_ENC}&limit=${LIMIT}" \
  | python3 "$(dirname "$0")/rlm-format" structural
