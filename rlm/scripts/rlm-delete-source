#!/usr/bin/env bash
# rlm-delete-source <source>
# Remove all documents, chunks, embeddings, and summaries for a source namespace.
# Use before re-indexing a project that has been heavily refactored or moved.
# Defaults to $PWD if no source is given.
set -euo pipefail

CERCLE_ADDR="${CERCLE_ADDR:-127.0.0.1:7770}"
SOURCE="${1:-${CERCLE_SOURCE:-$PWD}}"

curl -s --fail-with-body -X DELETE "http://${CERCLE_ADDR}/source?source=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$SOURCE")" \
  | python3 "$(dirname "$0")/rlm-format" delete-source
